<div class="announcement">A little slower, a little softer <span>·</span> complimentary shipping over $100</div>
<header class="header">
  <button class="icon-button menu-toggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
  <a class="wordmark" href="/" aria-label="Morrow home">morrow<span>®</span></a>
  <nav class="main-nav" aria-label="Main navigation">
    <a class="active" href="#shop">Shop</a>
    <a href="#story">Our story</a>
    <a href="#journal">Journal</a>
  </nav>
  <div class="header-actions">
    <form class="search-form" action="/" method="get" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 4 4"></path></svg>
      <input type="search" name="q" value="<%= search %>" placeholder="Search pieces" aria-label="Search pieces">
    </form>
    <a href="#account" class="account-link">Account</a>
    <button class="bag-button" aria-label="Shopping bag, <%= cartCount %> items">Bag <span class="bag-count"><%= cartCount %></span></button>
  </div>
</header>
